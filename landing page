                className="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold rounded-xl text-xs"
              >
                Tutup Window
              </button>
              <button 
                onClick={() => window.print()}
                className="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs flex items-center gap-1.5 shadow-md"
              >
                <Printer className="w-4 h-4" />
                <span>Cetak Dokumen PDF</span>
              </button>
            </div>
          </div>
        </div>
      )}

      {}
      {showSecurityModal && (
        <div className="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
          <div className="bg-slate-900 border border-slate-800 text-slate-100 max-w-lg w-full rounded-2xl p-6 space-y-4 max-h-[85vh] overflow-y-auto">
            <div className="flex items-center justify-between pb-3 border-b border-slate-800">
              <h3 className="font-bold text-white text-sm flex items-center gap-2">
                <ShieldCheck className="w-5 h-5 text-amber-400" />
                <span>Arsitektur Realtime & Rule Database RT 003</span>
              </h3>
              <button onClick={() => setShowSecurityModal(false)} className="text-slate-400 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="text-xs space-y-3 text-slate-300 leading-relaxed font-mono bg-slate-950 p-4 rounded-xl border border-slate-800">
              <p className="text-emerald-400 font-bold">// Rules Firestore Security RT 003 Muktiwari</p>
              <p className="text-slate-400">rules_version = '2';</p>
              <p className="text-slate-400">service cloud.firestore {'{'}</p>
              <p className="pl-4 text-slate-400">match /databases/{'{database}'}/documents {'{'}</p>
              <p className="pl-8 text-amber-300">// Publik Warga & Pengurus Realtime Data</p>
              <p className="pl-8 text-slate-300">match /artifacts/{'{appId}'}/public/data/{'{document=**}'} {'{'}</p>
              <p className="pl-12 text-emerald-300">allow read, write: if true;</p>
              <p className="pl-8 text-slate-300">{'}'}</p>
              <p className="pl-4 text-slate-400">{'}'}</p>
              <p className="text-slate-400">{'}'}</p>
            </div>

            <p className="text-xs text-slate-400 leading-relaxed">
              *Data kependudukan, kas, pengumuman, dan agenda tersimpan secara permanen pada Firestore Cloud Database dan terhubung langsung secara realtime dengan seluruh perangkat warga & pengurus RT 003 RW 037 Muktiwari.
            </p>

            <div className="pt-2 flex justify-end">
              <button
                onClick={() => setShowSecurityModal(false)}
                className="px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl text-xs"
              >
                Mengerti & Tutup
              </button>
            </div>
          </div>
        </div>
      )}

      {}
      {showLogoutModal && (
        <div className="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
          <div className="bg-slate-900 border border-slate-800 text-slate-100 max-w-sm w-full rounded-2xl p-6 space-y-5 text-center shadow-2xl">
            <div className="w-14 h-14 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-400 flex items-center justify-center mx-auto">
              <LogOut className="w-7 h-7" />
            </div>

            <div>
              <h3 className="font-bold text-white text-base">Konfirmasi Keluar</h3>
              <p className="text-xs text-slate-300 mt-2">Apakah Anda yakin ingin keluar dari akun Anda?</p>
            </div>

            <div className="grid grid-cols-2 gap-3 pt-2">
              <button
                onClick={() => setShowLogoutModal(false)}
                className="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded-xl text-xs transition-all"
              >
                Tidak
              </button>
              <button
                onClick={confirmLogout}
                className="px-4 py-2.5 bg-rose-500 hover:bg-rose-600 text-white font-bold rounded-xl text-xs transition-all shadow-md shadow-rose-500/20"
              >
                Ya, Keluar
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
